---
import '../styles/global.css';
import { site } from '../site';
import { t, home, type Lang } from '../i18n';

interface Props { lang: Lang; title?: string; description?: string; alt: string }
const { lang, title, description, alt } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${s.role}`;
const desc = description ?? s.description;
const base = home(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang === 'fr' ? 'en' : 'fr'} href={new URL(alt, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#0a0a0b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
  <nav class="nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
    <div class="wrap">
      <a href={base} class="logo">{site.name}</a>
      <ul>
        <li><a href={`${base}#apropos`}>{s.nav.about}</a></li>
        <li><a href={`${base}#projets`}>{s.nav.projects}</a></li>
        <li><a href={`${base}#parcours`}>{s.nav.path}</a></li>
        <li><a href={`${base}#contact`}>{s.nav.contact}</a></li>
      </ul>
      <a class="lang" href={alt} hreflang={lang === 'fr' ? 'en' : 'fr'} aria-label={s.switchLabel}>
        {lang === 'fr' ? <><b>FR</b> / EN</> : <>FR / <b>EN</b></>}
      </a>
    </div>
  </nav>
  <main id="main"><slot /></main>
  <footer class="footer"><div class="wrap mono"><span>{site.name}, {new Date().getFullYear()}</span><span>{s.footer}</span></div></footer>
  <script>import '../scripts/motion';</script>
</body>
</html>
