---
// Vraies captures de l'app SvenskaCore (390x844 en densité 2) : un écran par étape du projet phare.
import type { Lang } from '../i18n';
interface Props { lang: Lang; still?: boolean }
const { lang, still = false } = Astro.props;
const fr = lang === 'fr';
const screens = [
  { file: '1-etude', alt: fr ? "Carte de révision « hej då » avec IPA, audio et boutons de notation" : 'Review card "hej då" with IPA, audio and grading buttons' },
  { file: '2-decks', alt: fr ? 'Onglet Fondations : decks par niveau A1 et A2' : 'Foundations tab: decks by level A1 and A2' },
  { file: '3-classement', alt: fr ? 'Onglet Classement : série de 12 jours et classement de la semaine' : 'Leaderboard tab: 12-day streak and weekly ranking' },
];
const shown = still ? screens.slice(0, 1) : screens;
---
<div class="phone-stage">
  <div class="phone">
    <div class="screen">
      {shown.map((s, i) => (
        <img
          class:list={['scr', { on: i === 0 }]}
          src={`/projets/svenskacore/${lang}-${s.file}.png`}
          alt={s.alt}
          width="390"
          height="844"
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ))}
    </div>
  </div>
</div>
